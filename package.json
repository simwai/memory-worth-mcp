{
  "name": "memory-worth-mcp",
  "version": "1.0.0",
  "description": "Persistent agent memory with trust scoring and project-scoped routing for MCP",
  "type": "module",
  "main": "dist/mcp-server.js",
  "bin": {
    "memory-worth-mcp": "dist/mcp-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/mcp-server.ts",
    "start": "node dist/mcp-server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release:patch": "node scripts/release.js patch",
    "release:minor": "node scripts/release.js minor",
    "release:major": "node scripts/release.js major",
    "release:dry:patch": "node scripts/release.js patch --dry-run",
    "release:dry:minor": "node scripts/release.js minor --dry-run",
    "release:dry:major": "node scripts/release.js major --dry-run"
  },
  "keywords": [
    "mcp",
    "memory",
    "agent",
    "trust-scoring",
    "project-scoped"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "better-sqlite3": "^9.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}